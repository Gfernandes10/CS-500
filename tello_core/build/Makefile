	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_state_parser.dir/build.make CMakeFiles/test_state_parser.dir/tests/test_state_parser.cpp.o
.PHONY : tests/test_state_parser.cpp.o

tests/test_state_parser.i: tests/test_state_parser.cpp.i
.PHONY : tests/test_state_parser.i

# target to preprocess a source file
tests/test_state_parser.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_state_parser.dir/build.make CMakeFiles/test_state_parser.dir/tests/test_state_parser.cpp.i
.PHONY : tests/test_state_parser.cpp.i

tests/test_state_parser.s: tests/test_state_parser.cpp.s
.PHONY : tests/test_state_parser.s

# target to generate assembly for a file
tests/test_state_parser.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_state_parser.dir/build.make CMakeFiles/test_state_parser.dir/tests/test_state_parser.cpp.s
.PHONY : tests/test_state_parser.cpp.s

